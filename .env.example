# Copy this file to .env for local development. Never commit the real .env.
# On Render, set these in the dashboard instead (see README).

# Local development only. Never True in production.
DEBUG=True

# Required when DEBUG is not True. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Leave blank to use a local SQLite file (db.sqlite3).
# For Supabase PostgreSQL, paste the connection string from the Supabase dashboard
# (Connect -> Session pooler is recommended for Render). Percent-encode special
# characters in the password, e.g. @ becomes %40.
DATABASE_URL=

# Production hosts, comma separated, no scheme. The Render hostname is added
# automatically; list only extra custom domains here.
ALLOWED_HOSTS=
# Full origins including https://, comma separated. Needed for custom domains.
CSRF_TRUSTED_ORIGINS=

# IANA time zone name that decides what "today" means, e.g. UTC, Europe/London, America/Chicago.
TIME_ZONE=UTC

# Set to False after you've created your own account to stop strangers signing up.
ALLOW_REGISTRATION=True

# Optional: move the admin site to a less guessable path.
ADMIN_URL=admin/

# Optional database tuning.
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=600
# Only if you use Supabase's transaction pooler (port 6543):
# DB_TRANSACTION_POOLER=True
# Optional HTTPS tuning for production.
# SECURE_HSTS_SECONDS=3600
